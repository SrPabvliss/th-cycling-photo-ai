# Required at runtime
GEMINI_API_KEY=your_google_ai_studio_key_here
# Or alias (either works):
# GOOGLE_AI_API_KEY=your_google_ai_studio_key_here

# Pipeline defaults (override only if needed)
DETECTOR_TYPE=yolo
OCR_TYPE=parseq
COLOR_STRATEGY_TYPE=gemini
YOLO_WEIGHTS=/app/weights/yolo11m_v3cleaned/best.pt
PARSEQ_WEIGHTS=/app/weights/parseq_4phase
OCR_CONFIDENCE_THRESHOLD=0.70

# Color parallelism (added 2026-05-17)
COLOR_PARALLEL_WORKERS=4
GEMINI_MAX_CONCURRENCY=12

# Server
HOST=0.0.0.0
PORT=8001

# Optional: only if using Roboflow detector (academic ablation, not prod)
# ROBOFLOW_API_KEY=
# ROBOFLOW_MODEL_ID=

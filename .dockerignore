# Git
.git
.gitignore

# Python
__pycache__
*.pyc
.venv
*.egg-info
.pytest_cache
.ruff_cache

# IDE
.vscode
.idea
.claude

# Data (large, not needed in container)
data/
experiments/
notebooks/
scripts/
runs/
debug_out/

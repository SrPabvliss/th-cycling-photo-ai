# Git
.git
.gitignore

# Python
__pycache__
*.pyc
.venv
*.egg-info
.pytest_cache
.ruff_cache

# IDE
.vscode
.idea
.claude

# Data (large, not needed in container)
data/
experiments/
notebooks/
scripts/
runs/
debug_out/
judgments/
apps/

# Docs
*.md
!README.md
docs/

# Tests (not needed in production)
tests/

# Config files not needed in production
configs/

# Weights — exclude all by default, re-include only production subdirs.
# Dockerfile COPY references these via explicit paths.
weights/**
!weights/yolo11m_v3cleaned/**
!weights/parseq_4phase/**

# Stray model weights at repo root (not deployed)
*.pth

# Graphify output
graphify-out/

# Env files (secrets stay out of image)
.env
